# OpenStanley — example environment. Copy to `.env` in the repo root and fill in.
# Everything here is OPTIONAL except the LLM key: without it the agent can't write.

# ── LLM (required) ─────────────────────────────────────────────
# Any OpenAI- or Anthropic-compatible endpoint. GLM via z.ai is the tested default
# (model + base_url live in data/config.toml).
OPENSTANLEY_LLM_API_KEY=your-key-here

# ── X access (all optional — pick ONE mode in data/config.toml [x] mode) ──
# mode=dryrun (default)   : nothing needed, simulated X, nothing posts
# mode=cookie (free)      : paste cookies from your logged-in browser session
OPENSTANLEY_X_COOKIES={"auth_token":"...","ct0":"..."}
# mode=api (official X API v2, paid):
OPENSTANLEY_X_BEARER=
OPENSTANLEY_X_API_KEY=
OPENSTANLEY_X_API_SECRET=
OPENSTANLEY_X_ACCESS_TOKEN=
OPENSTANLEY_X_ACCESS_SECRET=

# ── Telegram bot (optional — the phone frontend) ──
# Create a bot with @BotFather, then EITHER paste the token here OR set it in
# the dashboard (Settings → Telegram). Chat whitelisting happens on first /start.
OPENSTANLEY_TG_BOT_TOKEN=
