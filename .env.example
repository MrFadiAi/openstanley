# OpenStanley — example environment. Copy to .env (or export) and fill in.
# LLM (any OpenAI-compatible endpoint; GLM via z.ai shown)
XOPENSTANLEY_LLM_API_KEY=your-key
# XOPENSTANLEY_LLM_BASE_URL and model are set in data/config.toml

# X access — only needed for the matching mode in data/config.toml ([x] mode)
# mode=api (official X API v2, paid tier):
XOPENSTANLEY_X_BEARER=
XOPENSTANLEY_X_API_KEY=
XOPENSTANLEY_X_API_SECRET=
XOPENSTANLEY_X_ACCESS_TOKEN=
XOPENSTANLEY_X_ACCESS_SECRET=

# mode=cookie (free, twikit): paste cookies JSON from your logged-in browser session
XOPENSTANLEY_X_COOKIES={"auth_token":"...","ct0":"..."}

# mode=dryrun (default): nothing needed
